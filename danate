<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BlockShop — магазин игровых донатов | Донат для Minecraft, Roblox и CS2</title>
<meta name="description" content="BlockShop — современный магазин игровых донатов. Корзина, избранное и история заказов сохраняются в браузере. Быстрая покупка, моментальная выдача.">
<style>
  :root{
    --bg:#070b16;--bg-2:#0b1122;--surface:#101a33;--surface-2:#162342;
    --border:rgba(148,163,255,.16);--text:#eef2ff;--muted:#8b96b8;
    --accent:#6c8cff;--accent-2:#9b6cff;--grad:linear-gradient(120deg,#6c8cff,#9b6cff);
    --grad-soft:linear-gradient(120deg,rgba(108,140,255,.16),rgba(155,108,255,.16));
    --green:#38e08a;--amber:#ffb454;--pink:#ff6ca8;--danger:#ff5c7a;
    --radius:18px;--shadow:0 20px 60px -20px rgba(4,10,30,.85);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:"Segoe UI","Inter",system-ui,-apple-system,sans-serif;
    background:
      radial-gradient(900px 500px at 85% -10%,rgba(108,140,255,.14),transparent 60%),
      radial-gradient(800px 500px at 0% 10%,rgba(155,108,255,.12),transparent 55%),
      var(--bg);
    color:var(--text);line-height:1.55;min-height:100vh;
  }
  ::selection{background:rgba(108,140,255,.4)}
  a{color:inherit;text-decoration:none}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  input,select{font-family:inherit;color:inherit}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
  .hidden{display:none!important}

  header{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:rgba(7,11,22,.72);border-bottom:1px solid var(--border)}
  .nav{display:flex;align-items:center;gap:22px;height:66px}
  .brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:19px;letter-spacing:.3px}
  .logo{width:34px;height:34px;border-radius:10px;background:var(--grad);display:grid;place-items:center;box-shadow:0 8px 20px -6px rgba(108,140,255,.7)}
  .logo svg{width:20px;height:20px}
  .nav-links{display:flex;gap:22px;margin-left:auto;align-items:center}
  .nav-links a{color:var(--muted);font-weight:600;font-size:14.5px;transition:color .2s}
  .nav-links a:hover,.nav-links a.on{color:var(--text)}
  .nav-actions{display:flex;gap:10px;align-items:center}
  .icon-btn{position:relative;display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--surface);border:1px solid var(--border);transition:.2s}
  .icon-btn:hover{background:var(--surface-2)}
  .icon-btn svg{width:19px;height:19px}
  .icon-btn .badge{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;padding:0 4px;border-radius:18px;background:var(--pink);color:#fff;font-size:11px;font-weight:800;display:grid;place-items:center;transform:scale(0);transition:transform .2s}
  .icon-btn .badge.show{transform:scale(1)}
  .icon-btn .badge.fav{background:var(--amber)}
  .menu-toggle{display:none;margin-left:auto}

  .hero{position:relative;padding:78px 0 64px;overflow:hidden}
  .hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(108,140,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(108,140,255,.06) 1px,transparent 1px);background-size:52px 52px;-webkit-mask-image:radial-gradient(700px 400px at 60% 40%,#000,transparent 75%);mask-image:radial-gradient(700px 400px at 60% 40%,#000,transparent 75%);pointer-events:none}
  .hero-inner{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}
  .pill{display:inline-flex;align-items:center;gap:8px;background:var(--grad-soft);border:1px solid var(--border);color:var(--accent);font-size:13px;font-weight:700;padding:7px 13px;border-radius:30px;margin-bottom:22px}
  .pill .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green)}
  .hero h1{font-size:clamp(34px,5vw,54px);line-height:1.08;font-weight:900;letter-spacing:-.5px}
  .hero h1 .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{color:var(--muted);font-size:17px;max-width:52ch;margin:20px 0 30px}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;border-radius:13px;font-weight:700;font-size:15px;transition:transform .15s,box-shadow .2s,filter .2s}
  .btn-primary{background:var(--grad);color:#fff;box-shadow:0 14px 34px -10px rgba(108,140,255,.8)}
  .btn-primary:hover{transform:translateY(-2px);filter:brightness(1.06)}
  .btn-ghost{background:var(--surface);border:1px solid var(--border);color:var(--text)}
  .btn-ghost:hover{background:var(--surface-2)}
  .btn-block{width:100%}
  .hero-mini{display:flex;gap:22px;flex-wrap:wrap;margin-top:34px}
  .mini{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13.5px;font-weight:600}
  .mini svg{width:18px;height:18px;color:var(--green);flex-shrink:0}

  .mock-wrap{position:relative}
  .mock{background:linear-gradient(160deg,rgba(22,35,66,.9),rgba(11,17,34,.9));border:1px solid var(--border);border-radius:22px;padding:26px;box-shadow:var(--shadow);position:relative}
  .mock-head{display:flex;align-items:center;gap:11px;border-bottom:1px solid var(--border);padding-bottom:16px;margin-bottom:18px}
  .mock-head .logo{width:38px;height:38px;border-radius:11px}
  .mock-name{font-weight:800;font-size:17px}
  .mock-sub{font-size:12.5px;color:var(--muted)}
  .mock-progress{margin-left:auto;background:var(--grad-soft);color:var(--accent);font-size:11.5px;font-weight:800;padding:5px 10px;border-radius:30px}
  .mock-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px dashed var(--border)}
  .mock-row:last-of-type{border-bottom:none}
  .mock-label{color:var(--muted);font-size:14px;display:flex;align-items:center;gap:9px}
  .mock-label svg{width:17px;height:17px;color:var(--accent)}
  .mock-price{font-weight:800;font-size:16px}
  .mock-total{display:flex;justify-content:space-between;align-items:center;margin-top:18px;background:var(--grad-soft);border:1px solid var(--border);padding:14px 16px;border-radius:14px;font-weight:900;font-size:17px}
  .mock-float{position:absolute;right:-18px;top:-18px;background:var(--surface-2);border:1px solid var(--border);padding:10px 16px;border-radius:12px;font-size:13px;font-weight:800;box-shadow:var(--shadow);display:flex;align-items:center;gap:8px}
  .mock-float svg{width:16px;height:16px;color:var(--green)}

  .strip{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(255,255,255,.015)}
  .strip-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:26px 0}
  .strip-item{display:flex;align-items:center;gap:14px}
  .strip-icon{width:46px;height:46px;border-radius:13px;background:var(--grad-soft);border:1px solid var(--border);display:grid;place-items:center;flex-shrink:0}
  .strip-icon svg{width:22px;height:22px;color:var(--accent)}
  .strip-item strong{display:block;font-size:15px}
  .strip-item span{font-size:13px;color:var(--muted)}

  section{padding:72px 0}
  .sec-head{max-width:640px;margin-bottom:34px}
  .sec-head.center{margin-inline:auto;text-align:center}
  .sec-head h2{font-size:clamp(26px,4vw,38px);font-weight:900;letter-spacing:-.4px;line-height:1.1}
  .sec-head .sub{color:var(--muted);margin-top:12px;font-size:15.5px}
  .sec-head .tag{display:inline-block;color:var(--accent);font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px}

  .toolbar{display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:24px}
  .tabs{display:flex;gap:9px;flex-wrap:wrap}
  .tab{background:var(--surface);border:1px solid var(--border);padding:9px 18px;border-radius:30px;font-weight:700;font-size:14px;color:var(--muted);display:flex;gap:8px;align-items:center;transition:.2s}
  .tab:hover{color:var(--text)}
  .tab.active{background:var(--grad);color:#fff;border-color:transparent}
  .tab .count{font-size:12px;opacity:.8}
  .search{position:relative}
  .search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:17px;height:17px;color:var(--muted)}
  .search input{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:11px 14px 11px 40px;width:230px;font-size:14px;outline:none;transition:.2s}
  .search input:focus{border-color:var(--accent)}

  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .card{background:linear-gradient(160deg,var(--surface-2),var(--surface));border:1px solid var(--border);border-radius:var(--radius);padding:24px;display:flex;flex-direction:column;position:relative;overflow:visible;transition:transform .2s,border-color .2s,box-shadow .2s}
  .card:hover{transform:translateY(-5px);border-color:rgba(108,140,255,.45);box-shadow:var(--shadow)}
  .card.alt{background:linear-gradient(160deg,rgba(155,108,255,.14),var(--surface))}
  .card .fav{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:10px;background:rgba(7,11,22,.5);border:1px solid var(--border);display:grid;place-items:center;z-index:2;transition:.2s}
  .card .fav svg{width:17px;height:17px;color:var(--muted);transition:.2s}
  .card .fav:hover{background:var(--surface-2)}
  .card .fav.on svg{color:var(--danger);fill:var(--danger)}
  .card .tag2{position:absolute;top:14px;left:14px;font-size:11.5px;font-weight:800;padding:5px 10px;border-radius:30px;text-transform:uppercase;letter-spacing:.5px}
  .tag-hot{background:rgba(255,108,168,.18);color:var(--pink)}
  .tag-top{background:rgba(255,180,84,.18);color:var(--amber)}
  .tag-new{background:rgba(56,224,138,.16);color:var(--green)}
  .card .icon{width:52px;height:52px;border-radius:14px;background:var(--grad-soft);display:grid;place-items:center;margin:14px 0 18px}
  .card .icon svg{width:26px;height:26px;color:var(--accent)}
  .card h3{font-size:18px;margin-bottom:8px}
  .card p{color:var(--muted);font-size:14px;flex-grow:1}
  .card .feat{margin:16px 0;display:flex;flex-direction:column;gap:7px}
  .card .feat span{font-size:13px;color:var(--muted);display:flex;gap:8px;align-items:center}
  .card .feat svg{width:15px;height:15px;color:var(--green);flex-shrink:0}
  .card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:6px;gap:12px}
  .price{font-size:22px;font-weight:900}
  .price small{font-size:13px;color:var(--muted);font-weight:600}
  .add{background:var(--grad);color:#fff;font-weight:700;font-size:14px;padding:11px 18px;border-radius:12px;transition:transform .15s,box-shadow .2s}
  .add:hover{transform:translateY(-2px);box-shadow:0 10px 24px -8px rgba(108,140,255,.8)}
  .add.added{background:#16301f;color:var(--green);box-shadow:none}

  .how{background:linear-gradient(180deg,rgba(255,255,255,.0),rgba(255,255,255,.02),rgba(255,255,255,.0))}
  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;counter-reset:step}
  .step{position:relative;padding-top:48px}
  .step::before{counter-increment:step;content:counter(step);position:absolute;top:0;left:0;width:36px;height:36px;border-radius:11px;background:var(--grad);color:#fff;font-weight:900;font-size:16px;display:grid;place-items:center;box-shadow:0 10px 24px -8px rgba(108,140,255,.8)}
  .step h3{font-size:16.5px;margin-bottom:8px}
  .step p{color:var(--muted);font-size:14px}

  .game-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .game{display:flex;align-items:center;gap:15px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:16px;transition:.2s}
  .game:hover{background:var(--surface-2);border-color:rgba(108,140,255,.4)}
  .game .g-icon{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font-size:22px;flex-shrink:0}
  .game strong{display:block;font-size:15.5px}
  .game span{font-size:13px;color:var(--muted)}
  .gi-mc{background:linear-gradient(135deg,#3b3450,#2a2640)}
  .gi-roblox{background:linear-gradient(135deg,#38405c,#262b40)}
  .gi-cs{background:linear-gradient(135deg,#3a3f4a,#282c35)}
  .gi-ds{background:linear-gradient(135deg,#3c3a4a,#2a2838)}

  .faq{max-width:780px;margin:0 auto}
  .faq-item{border:1px solid var(--border);border-radius:14px;margin-bottom:12px;overflow:hidden;background:var(--surface)}
  .faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 20px;font-weight:700;font-size:15.5px;text-align:left}
  .faq-q svg{width:19px;height:19px;flex-shrink:0;transition:transform .25s;color:var(--accent)}
  .faq-item.open .faq-q svg{transform:rotate(45deg)}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease}
  .faq-a p{padding:0 20px 18px;color:var(--muted);font-size:14.5px}

  footer{border-top:1px solid var(--border);padding:44px 0 30px;background:rgba(255,255,255,.015)}
  .foot-grid{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;margin-bottom:30px}
  .foot-brand p{color:var(--muted);font-size:14px;max-width:34ch;margin-top:14px}
  .foot-cols{display:flex;gap:60px;flex-wrap:wrap}
  .foot-cols h4{font-size:13px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin-bottom:14px}
  .foot-cols a{display:block;color:var(--text);font-size:14px;padding:5px 0;opacity:.85;transition:.2s}
  .foot-cols a:hover{opacity:1;color:var(--accent)}
  .foot-bottom{border-top:1px solid var(--border);padding-top:22px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;color:var(--muted);font-size:13px}

  .overlay{position:fixed;inset:0;background:rgba(3,6,15,.6);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity .3s;z-index:90}
  .overlay.show{opacity:1;pointer-events:auto}
  .drawer{position:fixed;top:0;right:0;height:100vh;width:min(440px,100%);background:var(--bg-2);border-left:1px solid var(--border);transform:translateX(100%);transition:transform .35s cubic-bezier(.22,1,.36,1);z-index:100;display:flex;flex-direction:column}
  .drawer.open{transform:translateX(0)}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid var(--border)}
  .drawer-head h3{font-size:18px}
  .close{width:34px;height:34px;border-radius:10px;background:var(--surface);border:1px solid var(--border);display:grid;place-items:center;transition:.2s}
  .close:hover{background:var(--surface-2)}
  .close svg{width:17px;height:17px}
  .cart-items{flex-grow:1;overflow-y:auto;padding:20px 24px}
  .empty{text-align:center;color:var(--muted);padding:50px 10px}
  .empty svg{width:52px;height:52px;opacity:.5;margin-bottom:14px}
  .ci{display:flex;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--border)}
  .ci .c-icon{width:44px;height:44px;border-radius:12px;background:var(--grad-soft);display:grid;place-items:center;flex-shrink:0}
  .ci .c-icon svg{width:22px;height:22px;color:var(--accent)}
  .ci .c-mid{flex-grow:1}
  .ci .c-name{font-weight:700;font-size:14.5px}
  .ci .c-sub{font-size:12.5px;color:var(--muted)}
  .ci .c-qty{display:flex;align-items:center;gap:9px;margin-top:6px}
  .ci .c-qty button{width:24px;height:24px;border-radius:7px;background:var(--surface-2);border:1px solid var(--border);font-weight:800;display:grid;place-items:center;font-size:15px;transition:.15s}
  .ci .c-qty button:hover{background:var(--accent);color:#fff}
  .ci .c-qty .q{font-weight:800;min-width:16px;text-align:center}
  .ci .c-price{font-weight:800;font-size:14.5px}
  .ci .c-del{color:var(--muted);opacity:.7;transition:.2s}
  .ci .c-del:hover{color:var(--pink);opacity:1}
  .ci .c-del svg{width:17px;height:17px}
  .drawer-foot{border-top:1px solid var(--border);padding:20px 24px 24px;background:var(--bg-2)}
  .total-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
  .total-row .val{font-size:24px;font-weight:900}
  .checkout{width:100%;padding:15px;border-radius:13px;background:var(--grad);color:#fff;font-size:16px;font-weight:800;box-shadow:0 14px 34px -10px rgba(108,140,255,.8);transition:.2s}
  .checkout:hover{transform:translateY(-2px);filter:brightness(1.06)}
  .checkout:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none}
  .hint{font-size:12px;color:var(--muted);text-align:center;margin-top:12px}
  .clear-cart{width:100%;margin-top:10px;padding:10px;border-radius:11px;border:1px solid var(--border);color:var(--muted);font-size:13px;font-weight:600;transition:.2s}
  .clear-cart:hover{border-color:var(--danger);color:var(--danger)}

  .toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,80px);z-index:120;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:13px 20px;font-weight:700;font-size:14px;box-shadow:var(--shadow);display:flex;gap:10px;align-items:center;opacity:0;transition:.35s cubic-bezier(.22,1,.36,1);max-width:92vw}
  .toast.show{transform:translate(-50%,0);opacity:1}
  .toast svg{width:18px;height:18px;color:var(--green);flex-shrink:0}

  .modal{position:fixed;inset:0;z-index:110;display:none;place-items:center;padding:20px}
  .modal.show{display:grid}
  .modal-box{background:var(--bg-2);border:1px solid var(--border);border-radius:20px;width:min(520px,100%);max-height:88vh;overflow-y:auto;box-shadow:var(--shadow)}
  .modal-box.pad{padding:36px 32px}
  .modal-box .ok{width:64px;height:64px;border-radius:50%;background:rgba(56,224,138,.14);display:grid;place-items:center;margin:0 auto 18px}
  .modal-box .ok svg{width:32px;height:32px;color:var(--green)}
  .modal-box h3{font-size:22px;margin-bottom:8px}
  .modal-box p{color:var(--muted);font-size:14.5px;margin-bottom:22px}
  .modal-box .btn{width:100%}
  .modal-body{padding:26px 28px}
  .modal-foot{display:flex;gap:12px;padding:0 28px 28px}
  .modal-foot .btn{flex:1}

  .field{display:flex;flex-direction:column;gap:8px;margin-bottom:16px;text-align:left}
  .field label{font-size:13.5px;font-weight:700;color:var(--muted)}
  .field input,.field select,.field textarea{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 14px;font-size:15px;outline:none;transition:.2s;width:100%}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);background:var(--surface-2)}
  .field .err{color:var(--danger);font-size:12.5px;display:none}
  .field.invalid input{border-color:var(--danger)}
  .field.invalid .err{display:block}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .summary{background:var(--grad-soft);border:1px solid var(--border);border-radius:14px;padding:16px;margin-bottom:18px}
  .summary-row{display:flex;justify-content:space-between;padding:6px 0;font-size:14px;color:var(--muted)}
  .summary-row.total{color:var(--text);font-weight:800;font-size:16px;border-top:1px dashed var(--border);margin-top:8px;padding-top:10px}

  .orders-list{display:flex;flex-direction:column;gap:14px}
  .order{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px 20px;display:flex;gap:16px;align-items:center;flex-wrap:wrap}
  .order .o-id{font-size:13px;color:var(--muted);font-weight:700;min-width:110px}
  .order .o-meta{flex-grow:1;min-width:180px}
  .order .o-date{font-size:12.5px;color:var(--muted)}
  .order .o-items{font-size:13.5px;margin-top:3px}
  .order .o-total{font-weight:900;font-size:17px}
  .st{font-size:12px;font-weight:800;padding:6px 12px;border-radius:30px}
  .st-wait{background:rgba(255,180,84,.15);color:var(--amber)}
  .st-done{background:rgba(56,224,138,.14);color:var(--green)}
  .st-cancel{background:rgba(255,92,122,.14);color:var(--danger)}

  .reveal{opacity:0;transform:translateY(26px);transition:opacity .6s ease,transform .6s ease}
  .reveal.in{opacity:1;transform:none}

  @media(max-width:960px){
    .hero-inner{grid-template-columns:1fr}
    .mock-wrap{max-width:460px}
    .grid{grid-template-columns:repeat(2,1fr)}
    .strip-grid{grid-template-columns:repeat(2,1fr);gap:20px}
