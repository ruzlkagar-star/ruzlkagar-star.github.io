     feat:["Пропуск на выбор","Подбор под вашу игру"],
     desc:"Открой платный гейм-пасс в популярных играх."},
    {id:"cs-case", cat:"cs", name:"Набор кейсов 10", price:449, period:"Моментально",
     feat:["10 ключей","Редкие скины","Инвентарь Steam"],
     desc:"Набор ключей и кейсов для коллекционеров."},
    {id:"cs-knife", cat:"cs", badge:"top", badgeT:"Топ", name:"Нож для инвентаря", price:1299, period:"Моментально",
     feat:["Скин-нож на выбор","Бонус 200 кредитов"],
     desc:"Премиальный нож, который выделит инвентарь."},
    {id:"vip-1", cat:"vip", badge:"hot", badgeT:"Хит", name:"VIP Сервер", price:199, period:"Навсегда",
     feat:["Роль VIP в Discord","Бонус к опыту","Закрытый чат"],
     desc:"Привилегия сразу в нескольких играх и Discord."},
    {id:"vip-2", cat:"vip", badge:"new", badgeT:"Ново", name:"Суперпакет", price:1990, period:"Навсегда",
     feat:["VIP во всех играх","Годовой кейс","Золотой префикс"],
     desc:"Максимум бонусов сразу для всех проектов."}
  ];

  // ---- state ----
  var cart = safeParse("bs_cart", {});
  var favs = safeParse("bs_favs", []);
  var orders = safeParse("bs_orders", []);
  var nick = safeGet("bs_nick", "");
  var server = safeGet("bs_server", "");
  var email = safeGet("bs_email", "");

  var currentCat = "all";
  var searchQ = "";
  var drawerMode = "cart";

  function safeGet(k,d){try{var v=localStorage.getItem(k);return v===null?d:v;}catch(e){return d;}}
  function safeSet(k,v){try{localStorage.setItem(k,v);}catch(e){}}
  function safeParse(k,d){try{var v=localStorage.getItem(k);return v?JSON.parse(v):d;}catch(e){return d;}}
  function saveKey(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}

  // ---- helpers ----
  function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}
  function money(n){return (Number(n)||0).toLocaleString("ru-RU") + " ₽";}
  function catInfo(id){return CAT_DEFS[id]||{label:id,color:"#6c8cff",icon:""};}
  function findPkg(id){return PACKAGES.filter(function(p){return p.id===id;})[0];}
  function cartCount(){return Object.keys(cart).reduce(function(s,k){return s+cart[k];},0);}
  function cartTotal(){return PACKAGES.reduce(function(s,p){return s+(cart[p.id]?cart[p.id]*p.price:0);},0);}

  // ---- catalog render ----
  function visibleList(){
    var list = currentCat==="all" ? PACKAGES.slice() : PACKAGES.filter(function(p){return p.cat===currentCat;});
    if(searchQ){
      var q = searchQ.toLowerCase();
      var catLabel = list.map ? null : null;
      list = list.filter(function(p){
        var cat = catInfo(p.cat).label.toLowerCase();
        return p.name.toLowerCase().indexOf(q)>=0 ||
               p.desc.toLowerCase().indexOf(q)>=0 ||
               p.feat.join(" ").toLowerCase().indexOf(q)>=0 ||
               cat.indexOf(q)>=0;
      });
    }
    return list;
  }

  function cardHTML(p){
    var t = p.badge ? '<span class="tag2 tag-'+p.badge+'">'+esc(p.badgeT)+'</span>':'';
    var c = catInfo(p.cat);
    var feats = p.feat.map(function(f){return '<span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'+esc(f)+'</span>';}).join("");
    var period = p.period ? '<small> / '+esc(p.period)+'</small>' : '';
    var favOn = favs.indexOf(p.id)>=0 ? ' on' : '';
    var extra = p.cat==="vip" ? ' alt' : '';
    return '<article class="card'+extra+'" data-id="'+p.id+'">'+t+
      '<button class="fav'+favOn+'" data-fav="'+p.id+'" aria-label="'+(favOn?'Убрать':'Добавить')+' '+esc(p.name)+' из избранного" title="Избранное"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>'+
      '<div class="icon">'+c.icon+'</div>'+
      '<h3>'+esc(p.name)+'</h3><p>'+esc(p.desc)+'</p>'+
      '<div class="feat">'+feats+'</div>'+
      '<div class="card-foot"><div class="price">'+money(p.price)+period+'</div>'+
      '<button class="add" data-add="'+p.id+'" aria-label="Добавить '+esc(p.name)+' в корзину">В корзину</button></div></article>';
  }

  function renderCatalog(){
    var grid = document.getElementById("grid");
    var list = visibleList();
    if(list.length===0){
      grid.innerHTML = '<div class="empty" style="grid-column:1/-1;padding:60px 10px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><p>Ничего не найдено.</p><p style="font-size:13px;margin-top:6px">Попробуй другой запрос или сними фильтр.</p></div>';
    } else {
      grid.innerHTML = list.map(cardHTML).join("");
    }
    updateCounts();
  }

  function updateCounts(){
    document.getElementById("cAll").textContent = PACKAGES.length;
    document.getElementById("cMc").textContent = PACKAGES.filter(function(p){return p.cat==="mc";}).length;
    document.getElementById("cRoblox").textContent = PACKAGES.filter(function(p){return p.cat==="roblox";}).length;
    document.getElementById("cCs").textContent = PACKAGES.filter(function(p){return p.cat==="cs";}).length;
    document.getElementById("cVip").textContent = PACKAGES.filter(function(p){return p.cat==="vip";}).length;
  }

  // ---- tabs + search ----
  var tabs = document.querySelectorAll("#tabs .tab");
  tabs.forEach(function(tb){
    tb.addEventListener("click",function(){
      tabs.forEach(function(x){x.classList.remove("active");});
      tb.classList.add("active");
      currentCat = tb.dataset.cat;
      renderCatalog();
    });
  });
  var searchInput = document.getElementById("searchInput");
  searchInput.addEventListener("input",function(){
    searchQ = searchInput.value.trim();
    renderCatalog();
  });

  // favorites toggle via delegation on grid
  document.getElementById("grid").addEventListener("click",function(e){
    var f = e.target.closest("[data-fav]");
    if(f){ toggleFav(f.dataset.fav); return; }
    var b = e.target.closest("[data-add]");
    if(b) addToCart(b.dataset.add);
  });

  function toggleFav(id){
    var i = favs.indexOf(id);
    if(i>=0){ favs.splice(i,1); toast("Убрано из избранного", true); }
    else { favs.push(id); toast("Добавлено в избранное"); }
    saveKey("bs_favs", favs);
    updateBadges();
    renderCatalog();
  }

  // ---- cart ----
  function addToCart(id){
    cart[id] = cart[id]?cart[id]+1:1;
    saveKey("bs_cart", cart);
    updateBadges();
    renderCart();
    var p = findPkg(id);
    toast(p.name+" добавлен в корзину");
    flashAdd(id);
  }
  function flashAdd(id){
    var btn = document.querySelector('.add[data-add="'+id+'"]');
    if(!btn) return;
    btn.textContent = "Добавлено ✓";
    btn.classList.add("added");
    setTimeout(function(){ if(btn){btn.textContent="В корзину";btn.classList.remove("added");} },1200);
  }

  function changeQty(id,delta){
    cart[id] = (cart[id]||0)+delta;
    if(cart[id]<=0) delete cart[id];
    saveKey("bs_cart", cart);
    updateBadges();
    if(drawerMode==="cart") renderCartItems();
    else refreshFavRender();
  }

  function renderCart(){
    updateBadges();
    renderCartItems();
  }

  function renderCartItems(){
    var box = document.getElementById("drawerItems");
    var keys = Object.keys(cart).filter(function(id){return findPkg(id);});
    if(keys.length===0){
      box.innerHTML = '<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><p>В корзине пока пусто.</p><p style="font-size:13px;margin-top:6px">Выберите пакет из каталога.</p></div>';
    } else {
      box.innerHTML = keys.map(function(id){
        var p = findPkg(id); var q = cart[id]; var c = catInfo(p.cat);
        return '<div class="ci">'+
          '<span class="c-icon">'+c.icon+'</span>'+
          '<div class="c-mid"><div class="c-name">'+esc(p.name)+'</div><div class="c-sub">'+esc(c.label)+' · '+esc(p.period)+'</div>'+
          '<div class="c-qty"><button data-dec="'+id+'" aria-label="Уменьшить количество">−</button><span class="q">'+q+'</span><button data-inc="'+id+'" aria-label="Увеличить количество">+</button></div></div>'+
          '<div class="c-price">'+money(p.price*q)+'</div>'+
          '<button class="c-del" data-del="'+id+'" aria-label="Удалить '+esc(p.name)+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button></div>';
      }).join("");
    }
    var n = cartCount();
    document.getElementById("drawerFoot").style.display = n===0 && drawerMode==="cart" ? "block" : "block";
    document.getElementById("drawerTotal").textContent = money(cartTotal());
    var coe = document.getElementById("checkoutBtn");
    coe.disabled = n===0;
    document.getElementById("clearCart").style.display = (n>0 && drawerMode==="cart") ? "block" : "none";
  }

  function updateBadges(){
    var cn = cartCount();
    var cb = document.getElementById("cartBadge");
    cb.textContent = cn; cb.classList.toggle("show", cn>0);
    var fn = favs.length;
    var fb = document.getElementById("favBadge");
    fb.textContent = fn; fb.classList.toggle("show", fn>0);
  }

  // drawer toggle generic
  function openDrawer(mode){
    drawerMode = mode || "cart";
    if(drawerMode==="fav"){
      rerenderDrawerFav();
    } else {
      document.getElementById("drawerTitle").textContent = "Ваша корзина";
      document.getElementById("checkoutBtn").style.display = "";
      document.getElementById("drawerFoot").style.display = "";
      renderCartItems();
    }
    document.getElementById("drawer").classList.add("open");
    document.getElementById("overlay").classList.add("show");
  }
  function closeDrawer(){
    document.getElementById("drawer").classList.remove("open");
    document.getElementById("overlay").classList.remove("show");
  }

  function refreshFavRender(){
    if(drawerMode==="fav"){
      document.getElementById("drawerTitle").textContent = "Избранное";
      document.getElementById("checkoutBtn").style.display = "none";
      document.getElementById("drawerFoot").style.display = "none";
      rerenderDrawerFav();
    }
  }
  function rerenderDrawerFav(){
    var box = document.getElementById("drawerItems");
    var list = PACKAGES.filter(function(p){return favs.indexOf(p.id)>=0;});
    if(list.length===0){
      box.innerHTML = '<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg><p>Избранное пусто.</p><p style="font-size:13px;margin-top:6px">Нажимай на сердечко в каталоге.</p></div>';
    } else {
      box.innerHTML = list.map(function(p){
        var c = catInfo(p.cat);
        return '<div class="ci">'+
          '<span class="c-icon">'+c.icon+'</span>'+
          '<div class="c-mid"><div class="c-name">'+esc(p.name)+'</div><div class="c-sub">'+esc(c.label)+' · '+esc(p.period)+'</div></div>'+
          '<div class="c-price">'+money(p.price)+'</div>'+
          '<button class="c-del" data-del="'+p.id+'" aria-label="Убрать '+esc(p.name)+' из избранного"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button></div>';
      }).join("");
    }
  }

  // drawer events
  document.getElementById("openCart").addEventListener("click",function(){openDrawer("cart");});
  document.getElementById("openFav").addEventListener("click",function(){openDrawer("fav");});
  document.getElementById("closeDrawer").addEventListener("click",closeDrawer);
  document.getElementById("overlay").addEventListener("click",closeDrawer);

  document.getElementById("drawerItems").addEventListener("click",function(e){
    if(drawerMode==="fav"){
      var fd = e.target.closest("[data-del]");
      if(fd){ toggleFav(fd.dataset.del); renderCatalog(); return; }
      return;
    }
    var target = e.target.closest("[data-inc],[data-dec],[data-del]");
    if(!target) return;
    var id = target.dataset.inc||target.dataset.dec||target.dataset.del;
    if(id===undefined) return;
    if(target.hasAttribute("data-inc")) changeQty(id,1);
    else if(target.hasAttribute("data-dec")) changeQty(id,-1);
    else { delete cart[id]; saveKey("bs_cart",cart); updateBadges(); renderCartItems(); }
  });

  document.getElementById("clearCart").addEventListener("click",function(){
    cart = {}; saveKey("bs_cart",cart); updateBadges(); renderCartItems();
    toast("Корзина очищена", true);
  });

  // ---- checkout ----
  document.getElementById("checkoutBtn").addEventListener("click",function(){
    if(cartCount()===0) return;
    var s = '';
    Object.keys(cart).forEach(function(id){
      var p = findPkg(id); if(!p) return;
      s += '<div class="summary-row"><span>'+esc(p.name)+' × '+cart[id]+'</span><span>'+money(p.price*cart[id])+'</span></div>';
    });
    s += '<div class="summary-row total"><span>Итого</span><span>'+money(cartTotal())+'</span></div>';
    document.getElementById("checkoutSummary").innerHTML = s;
    document.getElementById("fNick").value = nick;
    document.getElementById("fServer").value = server;
    document.getElementById("fEmail").value = email;
    document.getElementById("orderDone").classList.add("hidden");
    document.getElementById("checkoutForm").classList.remove("hidden");
    closeDrawer();
    openModal();
  });

  var formEls = {
    nick: document.getElementById("fNick"),
    server: document.getElementById("fServer"),
    email: document.getElementById("fEmail"),
    agree: document.getElementById("fAgree")
  };
  function validate(){
    var ok = true;
    var nickV = formEls.nick.value.trim();
    var srvV = formEls.server.value.trim();
    var emV = formEls.email.value.trim();
    var fNick = formEls.nick.closest(".field"), fSrv=formEls.server.closest(".field"), fEm=formEls.email.closest(".field");
    if(nickV.length<2){fNick.classList.add("invalid");ok=false;}else{fNick.classList.remove("invalid");}
    if(!srvV){fSrv.classList.add("invalid");ok=false;}else{fSrv.classList.remove("invalid");}
    var emOk = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emV);
    if(!emOk){fEm.classList.add("invalid");ok=false;}else{fEm.classList.remove("invalid");}
    if(!formEls.agree.checked){ok=false; if(!document.getElementById("agreeErr")){var s=document.createElement("div");s.id="agreeErr";s.className="err";s.style.display="block";s.textContent="Нужно согласиться";formEls.agree.parentNode.appendChild(s);} }
    return ok;
  }
  formEls.agree.addEventListener("change",function(){ var s=document.getElementById("agreeErr"); if(s) s.remove(); });
  document.getElementById("confirmOrder").addEventListener("click",function(){
    if(!validate()) return;
    var nickV = formEls.nick.value.trim(), srvV=formEls.server.value.trim(), emV=formEls.email.value.trim();
    saveKey("bs_nick", JSON.stringify(nickV)); saveKey("bs_server", JSON.stringify(srvV)); saveKey("bs_email", JSON.stringify(emV));
    nick=nickV; server=srvV; email=emV;

    var items = Object.keys(cart).filter(function(id){return findPkg(id);}).map(function(id){
      var p=findPkg(id); return {id:p.id, name:p.name, cat:p.cat, qty:cart[id], price:p.price};
    });
    var total = cartTotal();
    var order = {
      id: "BS-" + Date.now().toString().slice(-6),
      date: new Date().toISOString(),
      nick: nickV, server: srvV, email: emV,
      items: items, total: total,
      status: "wait"
    };
    orders.unshift(order);
    saveKey("bs_orders", orders);

    cart = {}; saveKey("bs_cart", cart); updateBadges(); renderCartItems();

    document.getElementById("doneId").textContent = order.id;
    document.getElementById("checkoutForm").classList.add("hidden");
    document.getElementById("orderDone").classList.remove("hidden");
    renderOrders();
  });
  document.getElementById("doneBtn").addEventListener("click",closeModal);

  // ---- modal ----
  function openModal(){document.getElementById("modal").classList.add("show");}
  function closeModal(){document.getElementById("modal").classList.remove("show");}
  document.getElementById("modal").addEventListener("click",function(e){ if(e.target===this) closeModal(); });

  // ---- orders ----
  function renderOrders(){
    var wrap = document.getElementById("ordersWrap");
    if(orders.length===0){
      wrap.innerHTML = '<div class="empty" style="border:1px solid var(--border);border-radius:16px;background:var(--surface)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3z"/><path d="M3 9h18M9 21V9"/></svg><p>Заказов пока нет.</p><p style="font-size:13px;margin-top:6px">Оформи первый заказ из корзины — и он появится здесь.</p></div>';
    } else {
      wrap.innerHTML = '<div class="orders-list">' + orders.map(function(o){
        var stT = {wait:["Ожидает оплаты","st-wait"], done:["Выдан","st-done"], cancel:["Отменён","st-cancel"]}[o.status]||["Ожидает оплаты","st-wait"];
        var itemsStr = o.items.map(function(it){return esc(it.name)+" × "+it.qty;}).join(", ");
        var dl = new Date(o.date);
        var dateStr = ("0"+dl.getDate()).slice(-2)+"."+("0"+(dl.getMonth()+1)).slice(-2)+"."+dl.getFullYear()+" "+("0"+dl.getHours()).slice(-2)+":"+("0"+dl.getMinutes()).slice(-2);
        return '<div class="order">'+
          '<div class="o-id">№' + esc(o.id) + '</div>'+
          '<div class="o-meta"><div class="o-date">'+dateStr+'</div>'+
          '<div class="o-items">'+itemsStr+'</div>'+
          '<div style="font-size:12.5px;color:var(--muted);margin-top:2px">Ник: '+esc(o.nick)+' · '+esc(o.server)+'</div></div>'+
          '<div class="o-total">'+money(o.total)+'</div>'+
          '<span class="st '+stT[1]+'">'+stT[0]+'</span></div>';
      }).join("") + '</div>';
    }
  }
  document.getElementById("btnOrders").addEventListener("click",function(){ /* scroll handled by anchor */ });

  // ---- toast ----
  var toastTimer;
  function toast(msg, neutral){
    var t = document.getElementById("toast");
    var ic = neutral
      ? '<svg viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14l-3-3"/></svg>';
    t.innerHTML = ic + esc(msg);
    t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){t.classList.remove("show");},2000);
  }

  // ---- mobile menu ----
  var menuToggle = document.getElementById("menuToggle");
  var navLinks = document.getElementById("navLinks");
  menuToggle.addEventListener("click",function(){
    var open = navLinks.classList.toggle("open");
    menuToggle.setAttribute("aria-expanded",String(open));
  });
  navLinks.addEventListener("click",function(e){
    if(e.target.tagName==="A") navLinks.classList.remove("open");
  });

  // ---- FAQ ----
  document.querySelectorAll(".faq-item").forEach(function(item){
    item.querySelector(".faq-q").addEventListener("click",function(){
      var open = item.classList.contains("open");
      document.querySelectorAll(".faq-item.open").forEach(function(o){
        o.classList.remove("open");
        var a=o.querySelector(".faq-a"); if(a) a.style.maxHeight="0";
      });
      if(!open){
        item.classList.add("open");
        var a = item.querySelector(".faq-a");
        a.style.maxHeight = a.scrollHeight + "px";
      }
    });
  });

  // ---- reveal on scroll ----
  if("IntersectionObserver" in window){
    var revealObs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){en.target.classList.add("in"); revealObs.unobserve(en.target);} });
    },{threshold:.12});
    document.querySelectorAll(".reveal").forEach(function(el){revealObs.observe(el);});
  } else {
    document.querySelectorAll(".reveal").forEach(function(el){el.classList.add("in");});
  }

  // ---- keyboard ----
  document.addEventListener("keydown",function(e){
    if(e.key==="Escape"){ closeDrawer(); closeModal(); }
  });

  document.getElementById("year").textContent = new Date().getFullYear();

  // init
  updateBadges();
  renderCartItems();
  renderCatalog();
  renderOrders();
})();
</script>
</body>
</html>
